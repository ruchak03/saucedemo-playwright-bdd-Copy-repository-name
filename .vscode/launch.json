
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SauceDemo BDD",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber.js",
      "args": [
        "--require-module",
        "ts-node/register",
        "--require",
        "support/world.ts",
        "--require",
        "step-definitions/login.steps.ts",
        "features/login.feature"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
